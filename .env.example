# Copie este arquivo para ".env" e preencha para usar o Turso (banco hospedado).
# Sem essas duas variáveis, o sistema usa o banco local em data/aprendiz.db.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Opcional — porta do servidor local (padrão: 3000)
PORT=3000

# E-mails transacionais (verificação de conta e redefinição de senha) via
# Resend (https://resend.com). Sem RESEND_API_KEY, os e-mails só ficam
# registrados no console (o resto do fluxo continua funcionando).
RESEND_API_KEY=

# URL usada para montar os links dos e-mails (ex.: .../verificar-email.html?token=...).
# Em produção, troque para a URL pública do sistema.
APP_URL=http://localhost:3000
